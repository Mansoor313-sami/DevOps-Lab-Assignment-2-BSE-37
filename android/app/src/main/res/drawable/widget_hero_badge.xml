<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent disc behind the hero glyph, so the icon reads as lit
     glass sitting on the accent gradient rather than a flat sticker. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <solid android:color="#33FFFFFF" />

    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />

</shape>
