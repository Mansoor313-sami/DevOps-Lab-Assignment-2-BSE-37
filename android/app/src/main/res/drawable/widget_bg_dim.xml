<?xml version="1.0" encoding="utf-8"?>
<!-- Widget canvas, dim mode. See widget_bg_light.xml for why gradients
     live in drawables rather than in the Glance composable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="28dp" />

    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#FF1E2531"
        android:centerColor="#FF242C3D"
        android:endColor="#FF2B2A4A" />

    <stroke
        android:width="1dp"
        android:color="#26A18CFF" />

</shape>
