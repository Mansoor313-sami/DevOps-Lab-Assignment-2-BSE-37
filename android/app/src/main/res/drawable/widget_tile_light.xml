<?xml version="1.0" encoding="utf-8"?>
<!-- Small stat tile / toolbar pill, light mode. Tighter radius and a
     quieter fill than the glass card so the hero stays dominant. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="16dp" />

    <solid android:color="#B3FFFFFF" />

    <stroke
        android:width="1dp"
        android:color="#14725CFF" />

</shape>
