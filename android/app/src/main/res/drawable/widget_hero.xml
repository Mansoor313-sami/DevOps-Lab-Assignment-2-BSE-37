<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero card behind the next class's attendance - the one saturated
  surface in the widget, so it reads as the primary information no
  matter which theme is active. Deliberately shared across light, dim
  and dark: the gradient is dark enough that white foreground text
  passes contrast in every mode, so it needs no per-theme variant.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="20dp" />

    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF6D4AFF"
        android:centerColor="#FF5B63F0"
        android:endColor="#FF3E86E8" />

</shape>
