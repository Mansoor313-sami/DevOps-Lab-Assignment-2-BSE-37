<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card, dark mode. See widget_glass_light.xml for why this is a
     translucent fill rather than a real backdrop blur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="20dp" />

    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#1FFFFFFF"
        android:endColor="#0DFFFFFF" />

    <stroke
        android:width="1dp"
        android:color="#2BFFFFFF" />

</shape>
