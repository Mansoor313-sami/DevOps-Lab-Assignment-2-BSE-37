<?xml version="1.0" encoding="utf-8"?>
<!-- Widget canvas, dark mode. See widget_bg_light.xml for why gradients
     live in drawables rather than in the Glance composable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="28dp" />

    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#FF080D1A"
        android:centerColor="#FF101830"
        android:endColor="#FF191243" />

    <stroke
        android:width="1dp"
        android:color="#338A75FF" />

</shape>
