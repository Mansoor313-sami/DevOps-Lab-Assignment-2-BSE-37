<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass card, light mode.

  A real backdrop blur is impossible in a RemoteViews widget, so the
  glass effect is approximated the only way available: a translucent
  fill that lets the canvas gradient show through, plus a brighter
  hairline stroke standing in for the lit edge a blurred pane would have.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="20dp" />

    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#E6FFFFFF"
        android:endColor="#99FFFFFF" />

    <stroke
        android:width="1dp"
        android:color="#1F725CFF" />

</shape>
